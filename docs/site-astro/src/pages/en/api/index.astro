---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getApiDocs } from '../../../lib/api-docs';

const apiDocs = await getApiDocs('en');
---
<BaseLayout title="API Documentation - Marionette" lang="en" languageSwitcherPath="/marionette/ja/api/">
  <article class="api-docs api-index">
    <h1>API Documentation</h1>
    <p>The API reference is split into one page per Markdown source file. Choose a section below or use the sidebar API navigation.</p>
    <div class="doc-card-grid">
      {apiDocs.map((doc) => (
        <a class="doc-card" href={`/marionette/en/api/${doc.slug}/`}>
          <strong>{doc.title}</strong>
          <span>{doc.fileName}</span>
        </a>
      ))}
    </div>
  </article>
</BaseLayout>
