---
import fs from 'node:fs/promises';
import path from 'node:path';
import MarkdownIt from 'markdown-it';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const apiDocsDir = path.resolve(process.cwd(), '..', '..', 'docs', 'api');
const sectionFiles = (await fs.readdir(apiDocsDir))
  .filter((name) => name.endsWith('.md'))
  .sort();

const markdownSections = await Promise.all(
  sectionFiles.map((name) => fs.readFile(path.join(apiDocsDir, name), 'utf-8')),
);
const markdown = markdownSections.join('\n\n');
const html = new MarkdownIt({ html: false, linkify: true, typographer: true }).render(markdown);
---
<BaseLayout title="API Documentation - Marionette" lang="en" languageSwitcherPath="/marionette/ja/api/">
  <article class="api-docs" set:html={html} />
</BaseLayout>
