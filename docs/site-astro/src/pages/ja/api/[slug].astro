---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getApiDocs, renderApiMarkdown } from '../../../lib/api-docs.mjs';

export async function getStaticPaths() {
  const docs = await getApiDocs('ja');
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const html = renderApiMarkdown(doc.markdown);
---
<BaseLayout title={`${doc.title} - Marionette API`} lang="ja" languageSwitcherPath={`/marionette/en/api/${doc.slug}/`}>
  <article class="api-docs" set:html={html} />
</BaseLayout>
